# Dev: /api is proxied to backend (see vite.config.js → http://127.0.0.1:5157)
VITE_API_BASE_URL=/api

# Dev logging: browser console + CMD terminal (vite). Set false to silence.
VITE_DEV_LOG=true
# Chỉ tắt log trên CMD, vẫn giữ browser console:
# VITE_DEV_LOG_TERMINAL=false

# Direct call (requires CORS + backend running):
# VITE_API_BASE_URL=https://localhost:7168/api

# LiveKit SFU WebSocket — browser must reach this host.
# Modes: docs/PROCTORING_NETWORK_MODES.md
# LAN:     VITE_LIVEKIT_URL=ws://10.20.4.154:7880
# Tailscale: VITE_LIVEKIT_URL=ws://100.86.244.117:7880
# Tunnel:  VITE_LIVEKIT_URL=wss://livekit.wpcteam.homes