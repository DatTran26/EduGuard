# Copy to .env in this folder:
#   Copy-Item .env.example .env
#
# Used by docker compose for coturn. Match WebRtc__IceServers__1__* in backend/EduGuard.Api/.env

TURN_REALM=wpcteam.homes
TURN_USERNAME=eduguard
TURN_SECRET=eduguard-dev-turn-secret

# Public IPv4 of the host running Docker (curl ifconfig.me). Required when GV/SV are on other networks.
# Leave empty for same-machine / LAN-only testing.
TURN_EXTERNAL_IP=
