# Copy to .env in this folder:
#   Copy-Item .env.example .env
#
# ASP.NET Core reads these as environment variables (double underscore = nested config).
# Values here override appsettings.json. Omit a line to keep appsettings default.

# SQL Server (optional — usually in appsettings.Development.json)
# ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=EduGuardExam;Trusted_Connection=True;TrustServerCertificate=True;

# Redis — leave empty or comment out to use appsettings default (localhost:6379)
ConnectionStrings__Redis=localhost:6379
Redis__Enabled=true

# LiveKit SFU — URL returned in sfu-config / sfu-token API (browser may override via frontend VITE_LIVEKIT_URL)
LiveKit__Enabled=true
LiveKit__Url=ws://localhost:7880
LiveKit__ApiKey=devkey
LiveKit__ApiSecret=eduguard-dev-livekit-secret

# TURN (coturn) — must match infra/livekit/.env TURN_USERNAME / TURN_SECRET
# WebRtc__IceServers__0__Urls__0=stun:stun.l.google.com:19302
# WebRtc__IceServers__1__Urls__0=turn:livekit.wpcteam.homes:3478?transport=udp
# WebRtc__IceServers__1__Urls__1=turn:livekit.wpcteam.homes:3478?transport=tcp
# WebRtc__IceServers__1__Username=eduguard
# WebRtc__IceServers__1__Credential=eduguard-dev-turn-secret

# CORS — add your frontend origin when hosting (comma-separated for multiple)
# Cors__AllowedOrigins__0=http://localhost:5173
# Cors__AllowedOrigins__1=https://your-frontend.example.com

# Email SMTP (optional — when Enabled=false, OTP is logged in Development console)
# Email__Enabled=true
# Email__Host=smtp.gmail.com
# Email__Port=587
# Email__UseSsl=true
# Email__Username=your-email@gmail.com
# Email__Password=your-app-password
# Email__FromAddress=noreply@eduguard.local
# Email__FromName=EduGuard

# Email verification on register (OTP). Set RequireOnRegister=false to skip verification in local dev.
# EmailVerification__RequireOnRegister=true
# EmailVerification__OtpExpiryMinutes=10
# EmailVerification__ResendCooldownSeconds=60
