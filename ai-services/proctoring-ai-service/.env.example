# Copy to .env in this folder:  Copy-Item .env.example .env
# Shared weights live in ai-services/models/ (filename only is enough)
PROCTORING_MODEL=yolo11n.pt

# Optional bind (docker-compose uses these)
# PROCTORING_HOST=127.0.0.1
# PROCTORING_PORT=8800

# Logging: DEBUG | INFO | WARNING | ERROR
# PROCTORING_LOG_LEVEL=INFO
